# Example of the project-local .env file format.
# Copy to ".env", fill in the real values, and never commit the real file.
#
# Easiest path: run `powershell -File setup.ps1` — it generates this file
# (including the database password and host token) and provisions the
# database. The variables below document what it creates.
#
# Server + client on the host machine read this file (the client also loads
# it from main.py; scripts/run_server.bat loads it via uvicorn --env-file;
# docker-compose.yml reads the TEAMMEETINGAI_PG_* variables).

# --- Database (server; also consumed by docker-compose.yml) -----------------
# SQLAlchemy URL for the PostgreSQL server database.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5433/teammeetingai
# Values used by docker-compose.yml to create the database container:
TEAMMEETINGAI_PG_USER=tma
TEAMMEETINGAI_PG_PASSWORD=<random-password>   # generated by setup.ps1
TEAMMEETINGAI_PG_DB=teammeetingai
TEAMMEETINGAI_PG_PORT=5433

# --- Server -----------------------------------------------------------------
# Shared secret for mutating endpoints; every machine that may record or
# delete meetings must send the same value in the X-Host-Token header.
TEAMMEETINGAI_HOST_TOKEN=<random-secret>      # generated by setup.ps1

# --- Transcription (server, required) ---------------------------------------
# Sarvam Saaras v4 primary transcription. The key comes from the environment
# only and is never logged.
TEAMMEETINGAI_SARVAM_API_KEY=<your-sarvam-key>

# --- Analysis (server, optional) --------------------------------------------
# Cloud meeting analysis via Groq. Requires the opt-in flag, a model, and an
# API key; leave ANALYSIS_BACKEND=none to run transcription only.
TEAMMEETINGAI_ANALYSIS_BACKEND=groq
TEAMMEETINGAI_ALLOW_CLOUD_ANALYSIS=1
TEAMMEETINGAI_GROQ_MODEL=<model-from-your-groq-console>
TEAMMEETINGAI_GROQ_API_KEY=<your-secret-key-starting-with-gsk_>

# --- Client -----------------------------------------------------------------
# Server base URL for desktop clients (default: http://localhost:8000).
# TEAMMEETINGAI_SERVER_URL=http://<server-lan-ip>:8000
