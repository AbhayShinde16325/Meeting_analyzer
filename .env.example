# TeamMeetingAI / FNW Meeting Analyzer - example environment
# Copy to .env and fill required values. Do NOT commit real secrets.

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# Use the SAME Supabase PostgreSQL DATABASE_URL as the existing FNW Task Manager.
# One database, one DATABASE_URL. Task Manager stays in `public` schema.
# Meeting Analyzer creates/uses schema `meeting_analyzer`.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Local Docker PostgreSQL (dev only; not Supabase)
TEAMMEETINGAI_PG_USER=tma
TEAMMEETINGAI_PG_PASSWORD=change-me
TEAMMEETINGAI_PG_DB=teammeetingai
TEAMMEETINGAI_PG_PORT=5433

# -----------------------------------------------------------------------------
# App ports
# -----------------------------------------------------------------------------
TEAMMEETINGAI_API_PORT=8000
TEAMMEETINGAI_APP_PORT=8000
TEAMMEETINGAI_CLIENT_PORT=5173

# -----------------------------------------------------------------------------
# Transcription / analysis (optional; configure only if used)
# -----------------------------------------------------------------------------
TEAMMEETINGAI_SARVAM_API_KEY=<sarvam-api-key>
TEAMMEETINGAI_ANALYSIS_BACKEND=none
TEAMMEETINGAI_ALLOW_CLOUD_ANALYSIS=0
TEAMMEETINGAI_GROQ_MODEL=<groq-model>
TEAMMEETINGAI_GROQ_API_KEY=<groq-api-key>

# -----------------------------------------------------------------------------
# Client / CORS
# -----------------------------------------------------------------------------
TEAMMEETINGAI_SERVER_URL=http://localhost:8000
TEAMMEETINGAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
