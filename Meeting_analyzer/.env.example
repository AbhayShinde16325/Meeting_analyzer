# Meeting Analyzer backend - example environment
# Copy to Meeting_analyzer/.env for local dev. Do NOT commit real secrets.

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# Use the SAME Supabase PostgreSQL DATABASE_URL as the existing FNW Task Manager.
# One database, one DATABASE_URL. Task Manager remains in `public` schema.
# Meeting Analyzer uses schema `meeting_analyzer` and its own Alembic version
# table: `meeting_analyzer.alembic_version`.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Local Docker PostgreSQL (dev only)
TEAMMEETINGAI_PG_USER=tma
TEAMMEETINGAI_PG_PASSWORD=change-me
TEAMMEETINGAI_PG_DB=teammeetingai
TEAMMEETINGAI_PG_PORT=5433

# -----------------------------------------------------------------------------
# Speech-to-text / analysis (optional)
# -----------------------------------------------------------------------------
TEAMMEETINGAI_SARVAM_API_KEY=<sarvam-api-key>
TEAMMEETINGAI_SARVAM_LANGUAGE_HINT=
TEAMMEETINGAI_SARVAM_NUM_SPEAKERS=0

TEAMMEETINGAI_ANALYSIS_BACKEND=none
TEAMMEETINGAI_ALLOW_CLOUD_ANALYSIS=0
TEAMMEETINGAI_GROQ_MODEL=<groq-model>
TEAMMEETINGAI_GROQ_API_KEY=<groq-api-key>

# Voice profiling (optional)
TEAMMEETINGAI_VOICE_PROFILING=0

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
TEAMMEETINGAI_API_HOST=0.0.0.0
TEAMMEETINGAI_API_PORT=8000
TEAMMEETINGAI_SERVER_URL=http://localhost:8000
TEAMMEETINGAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
