/* =============================================================================
   TeamMeetingAI - Application stylesheet (light theme only)
   Platform: Windows 10/11 (PySide6 / Qt)
   Purpose: consistent white backgrounds with dark text everywhere, readable
   transcripts, professional appearance. No light/dark switching: colours are
   fixed literals, and main() additionally installs a light application
   palette so the system theme can never leak in.
   ============================================================================= */

/* ---------- Base ---------- */

QMainWindow, QWidget {
    background-color: #f8fafc;
    color: #1e293b;
    font-family: "Segoe UI", system-ui, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
}

QMainWindow {
    padding-top: 8px;
}

/* ---------- Typography ---------- */

QLabel {
    color: #1e293b;
}

QLabel#appTitle {
    font-size: 32px;
    font-weight: 600;
    color: #1d4ed8;
    letter-spacing: -0.5px;
    padding: 16px 0;
}

QLabel#subtitle {
    color: #64748b;
    font-size: 14px;
}

QLabel#pageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 4px;
}

QLabel#sectionTitle,
QLabel.sectionTitle {
    font-weight: 600;
    font-size: 13px;
    color: #1e293b;
}

QLabel#muted {
    color: #64748b;
}

QLabel#errorText {
    color: #b91c1c;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

QLabel#consentText {
    color: #92400e;
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

QLabel#recordingActive {
    color: #b91c1c;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QLabel#recordingFinalising {
    color: #d97706;
    font-size: 18px;
    font-weight: 600;
}

QLabel#recordingIdle {
    color: #64748b;
    font-size: 18px;
    font-weight: 500;
}

QLabel#elapsedTime {
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 28px;
    font-weight: 500;
    color: #1e293b;
}

QLabel#emptyState {
    color: #64748b;
    padding: 40px 20px;
    font-size: 14px;
}

/* ---------- QFrame ---------- */

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    margin: 4px 0;
    min-height: 40px;
}

QFrame#statusCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    margin: 4px 0;
    min-height: 60px;
}

/* ---------- QLineEdit & QComboBox ---------- */

QLineEdit,
QComboBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    color: #1e293b;
    min-height: 28px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #1d4ed8;
}

QLineEdit:disabled,
QComboBox:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #1e293b;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
    min-height: 28px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    font-size: 12px;
    min-height: 24px;
    color: #1e293b;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

QComboBox::down-arrow {
    border-left: 3px solid #64748b;
    border-right: 3px solid #64748b;
    border-top: 3px solid #64748b;
    width: 0;
    height: 0;
    margin-right: 3px;
}

/* ---------- QPushButton ---------- */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 16px;
    color: #1e293b;
    font-size: 12px;
    font-weight: 500;
    min-width: 72px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #1d4ed8;
}

QPushButton:focus {
    border: 1px solid #1d4ed8;
}

QPushButton:disabled {
    color: #94a3b8;
    background-color: #f1f5f9;
    border-color: #e2e8f0;
}

QPushButton#primaryButton {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
    font-weight: 600;
    min-width: 80px;
    min-height: 36px;
}

QPushButton#primaryButton:hover {
    background-color: #2563e6;
    border-color: #2563e6;
    color: #ffffff;
}

QPushButton#primaryButton:disabled {
    background-color: #93c5fd;
    border-color: #93c5fd;
    color: #ffffff;
}

QPushButton#recordButton {
    background-color: #dc2626;
    border-color: #dc2626;
    color: #ffffff;
    font-weight: 600;
    min-width: 88px;
    min-height: 36px;
}

QPushButton#recordButton:hover {
    background-color: #b91c1c;
    border-color: #b91c1c;
    color: #ffffff;
}

QPushButton#recordButton:disabled {
    background-color: #fecaca;
    border-color: #fecaca;
    color: #b91c1c;
}

QPushButton#dangerButton {
    color: #dc2626;
    border-color: #fecaca;
    background-color: #fff5f5;
    font-weight: 500;
    min-height: 28px;
}

QPushButton#dangerButton:hover {
    background-color: #fee2e2;
    border-color: #fbcfe8;
    color: #b91c1c;
}

QPushButton#dangerButton:disabled {
    color: #fca5a5;
    background-color: #f8fafc;
    border-color: #e2e8f0;
}

QPushButton[role="small"] {
    padding: 4px 8px;
    font-size: 11px;
    min-width: auto;
    min-height: 24px;
}

QPushButton[role="ghost"] {
    background-color: transparent;
    border: none;
    color: #64748b;
    padding: 4px;
    min-height: 24px;
}

QPushButton[role="ghost"]:hover {
    background-color: #f1f5f9;
    color: #1e293b;
}

/* ---------- QTableWidget / QHeaderView ---------- */

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #e2e8f0;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
    color: #1e293b;
}

QHeaderView::section {
    background-color: #f1f5f9;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    padding: 6px;
    font-weight: 600;
    color: #1e293b;
    min-height: 24px;
}

QTableWidget::item {
    padding: 6px 8px;
    font-size: 12px;
    min-height: 24px;
    color: #1e293b;
}

QTableWidget::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

/* ---------- Text browsers (transcript / overview) ---------- */

QTextBrowser,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    color: #20242a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
}

QTextBrowser#detailBrowser,
QTextEdit#detailBrowser {
    font-size: 13px;
    padding: 8px;
}

/* ---------- Scrollbars ---------- */

QScrollBar:vertical {
    background-color: #f1f5f9;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 5px;
    min-height: 32px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::handle:vertical:pressed {
    background-color: #64748b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background-color: #f1f5f9;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 5px;
    min-width: 32px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

/* ---------- Checkboxes & radio buttons ---------- */

QCheckBox,
QRadioButton {
    background-color: transparent;
    color: #1e293b;
    spacing: 6px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #94a3b8;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94a3b8;
    border-radius: 3px;
    background-color: #ffffff;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

/* ---------- Group boxes & tool buttons ---------- */

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 10px;
    padding: 8px;
    color: #1e293b;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    color: #1e293b;
}

QToolButton {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 8px;
    color: #1e293b;
}

QToolButton:hover {
    background-color: #f1f5f9;
    border-color: #1d4ed8;
}

/* ---------- Menus & tooltips ---------- */

QMenuBar {
    background-color: #f8fafc;
    color: #1e293b;
}

QMenuBar::item:selected {
    background-color: #f1f5f9;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    color: #1e293b;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    color: #1e293b;
}

QMenu::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

QToolTip {
    background-color: #1e293b;
    color: #ffffff;
    border: none;
    padding: 4px 8px;
    font-size: 11px;
}

/* ---------- Progress bars ---------- */

QProgressBar {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #1e293b;
    font-size: 11px;
    padding: 2px;
    min-height: 16px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #1d4ed8;
    border-radius: 5px;
    margin: 1px;
    min-height: 14px;
}

/* ---------- Dialogs & message boxes ---------- */

QDialog {
    background-color: #ffffff;
    color: #1e293b;
    min-width: 320px;
}

QDialog QLabel {
    color: #1e293b;
}

QDialog QPushButton {
    min-width: 80px;
    padding: 6px 16px;
    min-height: 30px;
}

QMessageBox {
    background-color: #ffffff;
    color: #1e293b;
    min-width: 300px;
}

QMessageBox QLabel {
    min-width: 260px;
    color: #1e293b;
}

QMessageBox QPushButton {
    min-width: 72px;
    padding: 6px 14px;
    min-height: 28px;
}

/* ---------- Tabs ---------- */

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QTabBar::tab {
    padding: 8px 14px;
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    margin-right: 2px;
    font-size: 12px;
    color: #64748b;
    min-height: 24px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom: 2px solid #1d4ed8;
    color: #1e293b;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* ---------- Status bar ---------- */

QStatusBar {
    background-color: #f1f5f9;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 11px;
    padding: 3px 6px;
    min-height: 20px;
}

QStatusBar QLabel {
    color: #64748b;
}

/* ---------- File/folder dialogs ---------- */

QFileDialog {
    background-color: #ffffff;
    color: #1e293b;
}

QFileDialog QListView,
QFileDialog QTreeView,
QFileDialog QTableView {
    background-color: #ffffff;
    color: #1e293b;
}

/* End of stylesheet */
